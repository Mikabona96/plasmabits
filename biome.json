{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!build",
			"!.svelte-kit",
			"!coverage",
			"!static",
			"!examples",
			"!src-tauri"
		],
		"ignoreUnknown": false
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},

	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "always"
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
